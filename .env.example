# Copy this file to `.env` and paste your key in.
#
#   cp .env.example .env
#
# ⚠️ `.env` is in .gitignore. The key must never be committed, and it must never
# reach the browser — every call to Anthropic is made by apps/api, server-side.
#
# Without this key the site works exactly as it always has: the readiness report
# and the roadmap are deterministic and free. Only the "in plain words" panel
# changes, and it falls back to a summary assembled from the rules themselves.
#
# Get one at https://console.anthropic.com  →  API keys
ANTHROPIC_API_KEY=

# ── apps/assistant (the "ask your case" chat, M6) ───────────────────────────
# Voyage turns questions into vectors for search. Server-side only.
VOYAGE_API_KEY=
# Supabase project URL and its PUBLIC publishable key (quota + search; RLS
# allows reads only). Never the secret key here at runtime.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# ONLY for `python -m app.ingest`, run locally. Never on Lambda, never in the browser.
SUPABASE_SECRET_KEY=
# Where the assistant asks the engine for his road, e.g. the local TS API (http://127.0.0.1:3001).
BYG_API_BASE=

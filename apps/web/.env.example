# Copy to `.env.local` (gitignored) and fill in from Supabase → Project Settings → API.
#
# Both values are PUBLIC by design: the publishable key is meant for the browser.
# What protects users' data is RLS in the database, not this key.
# ⚠️ Never put the secret / service_role key here, or anywhere in apps/web.
#
# Leave them empty and accounts simply switch off: the site works as before M1.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
